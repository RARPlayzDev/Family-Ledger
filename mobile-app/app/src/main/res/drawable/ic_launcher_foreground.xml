<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon foreground (API 26+). Same geometry as ic_logo.xml; the path
    data is duplicated on purpose so each drawable stays independently editable.
    Re-run tools/generate-icons.ps1 after changing anything here so the API
    24-25 rasters and the Play Store icon match.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ledger card -->
    <path
        android:fillColor="#141619"
        android:pathData="M40.5,29.5 h27 a7.5,7.5 0 0 1 7.5,7.5 v34 a7.5,7.5 0 0 1 -7.5,7.5 h-27 a7.5,7.5 0 0 1 -7.5,-7.5 v-34 a7.5,7.5 0 0 1 7.5,-7.5 z"
        android:strokeColor="#2E3238"
        android:strokeWidth="1.6" />

    <!-- Accent rule -->
    <path
        android:pathData="M41,43 L67,43"
        android:strokeColor="#9AE6B4"
        android:strokeWidth="4.2"
        android:strokeLineCap="round" />

    <!-- Muted rules -->
    <path
        android:pathData="M41,54.5 L58,54.5"
        android:strokeColor="#9BA1AA"
        android:strokeWidth="3.8"
        android:strokeLineCap="round" />

    <path
        android:pathData="M41,66 L64,66"
        android:strokeColor="#9BA1AA"
        android:strokeWidth="3.8"
        android:strokeLineCap="round" />
</vector>
