<?xml version="1.0" encoding="utf-8"?>
<!--
    Themed-icon layer (Android 13+). A single colour only: the platform tints
    every filled pixel, so this has to read as a silhouette. The card stroke of
    the coloured version is drawn here as two filled subpaths (evenOdd) instead.
    Outer edge stays inside the 66dp guaranteed-visible circle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Card outline: outer rounded rect minus an inset copy -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M41.8,30.3 h24.4 a8,8 0 0 1 8,8 v31.4 a8,8 0 0 1 -8,8 h-24.4 a8,8 0 0 1 -8,-8 v-31.4 a8,8 0 0 1 8,-8 z M41.8,31.9 h24.4 a6.4,6.4 0 0 1 6.4,6.4 v31.4 a6.4,6.4 0 0 1 -6.4,6.4 h-24.4 a6.4,6.4 0 0 1 -6.4,-6.4 v-31.4 a6.4,6.4 0 0 1 6.4,-6.4 z" />

    <!-- Accent rule -->
    <path
        android:pathData="M41,43 L67,43"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.2"
        android:strokeLineCap="round" />

    <!-- Muted rules -->
    <path
        android:pathData="M41,54.5 L58,54.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.8"
        android:strokeLineCap="round" />

    <path
        android:pathData="M41,66 L64,66"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.8"
        android:strokeLineCap="round" />
</vector>
