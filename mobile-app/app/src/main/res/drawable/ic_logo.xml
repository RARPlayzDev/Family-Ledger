<?xml version="1.0" encoding="utf-8"?>
<!--
    FamilyLedger mark: a ledger card with one accent rule and two muted rules,
    the same geometry as public/favicon.svg in the web app.

    Everything is kept inside the 66dp circle that Android guarantees is visible
    after an icon mask is applied (radius 33 around 54,54), so this drawable is
    safe for both windowSplashScreenAnimatedIcon and the adaptive-icon
    foreground. Tooling/raster twin: tools/generate-icons.ps1
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ledger card -->
    <path
        android:fillColor="#141619"
        android:pathData="M40.5,29.5 h27 a7.5,7.5 0 0 1 7.5,7.5 v34 a7.5,7.5 0 0 1 -7.5,7.5 h-27 a7.5,7.5 0 0 1 -7.5,-7.5 v-34 a7.5,7.5 0 0 1 7.5,-7.5 z"
        android:strokeColor="#25282D"
        android:strokeWidth="1.6" />

    <!-- Accent rule: the "total" line -->
    <path
        android:pathData="M41,43 L67,43"
        android:strokeColor="#9AE6B4"
        android:strokeWidth="4.2"
        android:strokeLineCap="round" />

    <!-- Muted rules -->
    <path
        android:pathData="M41,54.5 L58,54.5"
        android:strokeColor="#9BA1AA"
        android:strokeWidth="3.8"
        android:strokeLineCap="round" />

    <path
        android:pathData="M41,66 L64,66"
        android:strokeColor="#9BA1AA"
        android:strokeWidth="3.8"
        android:strokeLineCap="round" />
</vector>
