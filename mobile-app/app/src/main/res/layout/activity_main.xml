<?xml version="1.0" encoding="utf-8"?>
<!--
    Shell layout.

    The WebView is *not* declared here: MainActivity creates it in code so that
    a renderer crash (onRenderProcessGone) can swap in a fresh instance without
    recreating the Activity. SwipeRefreshLayout therefore starts out childless.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fl_canvas" />

    <!-- Thin accent loading bar, pinned under the status bar. -->
    <ProgressBar
        android:id="@+id/page_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="top"
        android:max="100"
        android:progressBackgroundTint="@color/fl_transparent"
        android:progressTint="@color/fl_accent"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Shown instead of the WebView when the app can't be reached. -->
    <LinearLayout
        android:id="@+id/offline_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fl_canvas"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_logo" />

        <TextView
            android:id="@+id/offline_title"
            style="@style/TextAppearance.FamilyLedger.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            tools:text="Can't reach FamilyLedger" />

        <TextView
            android:id="@+id/offline_message"
            style="@style/TextAppearance.FamilyLedger.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            tools:text="Check your internet connection and try again." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/offline_retry"
            style="@style/Widget.FamilyLedger.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/error_retry" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/offline_browser"
            style="@style/Widget.FamilyLedger.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/error_open_browser" />
    </LinearLayout>
</FrameLayout>
