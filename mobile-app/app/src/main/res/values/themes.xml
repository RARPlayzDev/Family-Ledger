<?xml version="1.0" encoding="utf-8"?>
<!--
    The app is deliberately dark-only: the web app ships a single dark finance
    palette, so there is no values-night variant to drift out of sync. Do not
    add one without also giving the web app a light theme.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Shell theme. Every surface colour is stated explicitly (rather than
        inherited from a DayNight parent) so the window painted behind the
        WebView can never be lighter than the page, which would flash white
        between the splash screen and React's first paint.
    -->
    <style name="Theme.FamilyLedger" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/fl_canvas</item>
        <item name="android:colorBackground">@color/fl_canvas</item>
        <item name="colorSurface">@color/fl_surface</item>
        <item name="colorOnSurface">@color/fl_content</item>
        <item name="colorOnBackground">@color/fl_content</item>
        <item name="android:colorForeground">@color/fl_content</item>

        <item name="colorPrimary">@color/fl_accent</item>
        <item name="colorPrimaryVariant">@color/fl_accent_strong</item>
        <item name="colorOnPrimary">@color/fl_accent_ink</item>
        <item name="colorSecondary">@color/fl_accent</item>
        <item name="colorSecondaryVariant">@color/fl_accent_strong</item>
        <item name="colorOnSecondary">@color/fl_accent_ink</item>
        <item name="colorError">@color/fl_danger</item>
        <item name="colorOnError">@color/fl_canvas</item>

        <item name="android:textColorPrimary">@color/fl_content</item>
        <item name="android:textColorSecondary">@color/fl_content_muted</item>
        <item name="android:textColorHint">@color/fl_content_subtle</item>

        <!-- Edge to edge: MainActivity pads the root view by the current insets,
             so the bars stay transparent and the canvas shows through. -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/fl_transparent</item>
        <item name="android:navigationBarColor">@color/fl_transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>

    <!--
        Splash theme. installSplashScreen() in MainActivity hands over to
        Theme.FamilyLedger as soon as the first page finishes loading.
    -->
    <style name="Theme.FamilyLedger.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fl_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo</item>
        <item name="windowSplashScreenAnimationDuration">250</item>
        <item name="postSplashScreenTheme">@style/Theme.FamilyLedger</item>
    </style>

    <!-- ===================== Error / offline screen ===================== -->

    <style name="TextAppearance.FamilyLedger.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/fl_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="TextAppearance.FamilyLedger.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/fl_content_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <!-- Primary action: filled accent pill, sized for comfortable tapping. -->
    <style name="Widget.FamilyLedger.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">168dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="backgroundTint">@color/fl_accent</item>
        <item name="android:textColor">@color/fl_accent_ink</item>
        <item name="rippleColor">@color/fl_accent_ink</item>
        <item name="cornerRadius">8dp</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Secondary action: quiet text button under the primary one. -->
    <style name="Widget.FamilyLedger.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/fl_content_muted</item>
        <item name="rippleColor">@color/fl_line_strong</item>
    </style>
</resources>
