<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer policy.

    The app is a client for a shared server, so there is nothing here worth
    restoring from a backup — and the WebView's localStorage holds the session
    token, which must never travel to another device or into a cloud account.
    `android:allowBackup="false"` covers cloud backup; these excludes cover the
    Android 12+ device-to-device path, which allowBackup alone does not control.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
