# FamilyLedger environment variables (Vite)
# Copy this file to `.env.local` for local development and fill in real values.
#
# IMPORTANT
# - Only PUBLIC browser keys belong here. Anything prefixed with VITE_ is embedded
#   into the client bundle and is readable by anyone.
# - NEVER put the Supabase service_role key, secret key (sb_secret_...) or any
#   database password in a VITE_ variable.
#   Service-role keys may only be used inside Supabase Edge Functions, where they
#   are injected automatically by the platform.

# Project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Public client key. Either value works, use whichever your project exposes:
#   - legacy anon public key  (JWT starting with "eyJ...")
#   - new publishable key     ("sb_publishable_...", recommended for new projects)
VITE_SUPABASE_ANON_KEY=

# --- Optional: only used by the RLS integration test suite -------------------
# Create a throwaway/test Supabase project, apply the migrations, then point
# these at it (or run a local stack with `supabase start`). The suite is skipped
# automatically when these are not set. See SECURITY.md -> "Verifying RLS".
VITE_TEST_SUPABASE_URL=
VITE_TEST_SUPABASE_ANON_KEY=
